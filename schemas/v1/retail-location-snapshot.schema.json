{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homegrowncannalytics.com/schemas/v1/retail-location-snapshot.schema.json",
  "title": "RetailLocationSnapshot",
  "description": "A time-bounded, source-traceable snapshot of a licensed cannabis retail location.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "location_id",
    "license",
    "display_name",
    "address",
    "coordinates",
    "operating_status",
    "source",
    "observed_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "location_id": { "type": "string", "minLength": 1 },
    "legacy_tenant_id": { "type": ["string", "null"] },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jurisdiction", "number", "type", "status"],
      "properties": {
        "jurisdiction": { "type": "string", "const": "AK" },
        "number": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "status_raw": { "type": ["string", "null"] }
      }
    },
    "legal_name": { "type": ["string", "null"] },
    "display_name": { "type": "string", "minLength": 1 },
    "brand_id": { "type": ["string", "null"] },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatted", "city", "region", "postal_code", "country"],
      "properties": {
        "formatted": { "type": "string", "minLength": 1 },
        "line1": { "type": ["string", "null"] },
        "line2": { "type": ["string", "null"] },
        "city": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "const": "AK" },
        "postal_code": { "type": "string", "pattern": "^[0-9]{5}(-[0-9]{4})?$" },
        "country": { "type": "string", "const": "US" }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "crs", "source", "confidence"],
      "properties": {
        "latitude": { "type": "number", "minimum": 51, "maximum": 72 },
        "longitude": { "type": "number", "minimum": -180, "maximum": -129 },
        "crs": { "type": "string", "const": "EPSG:4326" },
        "source": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "operating_status": {
      "type": "string",
      "enum": ["operational", "pre_operational", "suspended", "inactive", "unknown"]
    },
    "timezone": { "type": "string", "default": "America/Anchorage" },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phone": { "type": ["string", "null"] },
        "website": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "record_id"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "record_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": ["string", "null"] },
        "source_uri": { "type": ["string", "null"] }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" }
  }
}


